# ============================================================================
# IncidentPilot - environment configuration
# Copy to `.env` and fill in. `.env` is gitignored. NEVER commit real keys.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
DEMO_MODE=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL (application state ONLY - never used as the agent's memory)
# ---------------------------------------------------------------------------
POSTGRES_USER=incidentpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=incidentpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full connection URL. If set, overrides the fields above.
DATABASE_URL=postgresql+asyncpg://incidentpilot:change-me@localhost:5432/incidentpilot

# ---------------------------------------------------------------------------
# Hindsight  (the agent's long-term memory - REQUIRED)
# Docs: https://hindsight.vectorize.io
#
# Hindsight Cloud (recommended, no Docker):
#   Sign up at https://hindsight.vectorize.io -> API key
#   HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
#   HINDSIGHT_API_KEY=hs_...
#
# Self-hosted (pip install hindsight-all; needs Postgres + an LLM key):
#   HINDSIGHT_API_URL=http://localhost:8888
#   HINDSIGHT_API_KEY=            # may be blank when self-hosted
# ---------------------------------------------------------------------------
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=engineering-prod

# Retention is async: we poll recall until the experience is actually
# recallable. These bound the wait so the demo can never hang.
HINDSIGHT_RETAIN_TIMEOUT_SECONDS=180
HINDSIGHT_RETAIN_POLL_SECONDS=3.0

# ---------------------------------------------------------------------------
# LLM (any OpenAI-compatible provider: OpenAI, Groq, OpenRouter, ...)
# Used for strategy generation, hypothesis updates and root-cause reasoning.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# Determinism: spec §30 requires temperature 0. Fixed seed where supported.
LLM_TEMPERATURE=0.0
LLM_SEED=1234
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Hindsight's own LLM config.
# Hindsight Cloud handles this for you. For SELF-HOSTED Hindsight only, set
# the key so Hindsight can extract facts on retain and embed them.
# ---------------------------------------------------------------------------
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=
